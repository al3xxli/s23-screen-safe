<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="ca.screensafe.app" android:versionCode="7" android:versionName="0.7-preview">
  <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />
  <instrumentation android:name=".SessionRunner" android:targetPackage="ca.screensafe.app" android:label="Screen Safe USB activation" />
  <application android:label="Screen Safe" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false">
    <service android:name=".TouchFilterService" android:label="Screen Safe touch filter" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/touch_filter" />
    </service>
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
